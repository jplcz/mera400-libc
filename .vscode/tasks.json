{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "llvmBinDir",
      "type": "promptString",
      "description": "Directory with the MERA-400 enabled llvm-mc, ld.lld, llvm-ar, llvm-objdump (empty: use PATH)",
      "default": ""
    },
    {
      "id": "crookImage",
      "type": "promptString",
      "description": "The raw CROOK image (.bin) to turn into ASSM text",
      "default": "${workspaceFolder}/build-crook/tests/crook/crook_test.bin"
    },
    {
      "id": "crookTitle",
      "type": "promptString",
      "description": "Title of the CROOK file (letters, digits, _)",
      "default": "PROG"
    }
  ],
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/mera400-toolchain.cmake",
        "-DLLVM_BIN_DIR=${input:llvmBinDir}"
      ],
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "install",
      "type": "shell",
      "command": "cmake",
      "args": ["--install", "${workspaceFolder}/build", "--prefix", "${workspaceFolder}/build/sysroot"],
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure"],
      "group": { "kind": "test", "isDefault": true },
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "configure (CROOK)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build-crook",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/mera400-toolchain.cmake",
        "-DMERA400_PLATFORM=crook",
        "-DLLVM_BIN_DIR=${input:llvmBinDir}"
      ],
      "problemMatcher": []
    },
    {
      "label": "build (CROOK)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build-crook"],
      "problemMatcher": []
    },
    {
      "label": "test (CROOK)",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build-crook", "--output-on-failure"],
      "dependsOn": "build (CROOK)",
      "problemMatcher": []
    },
    {
      "label": "configure (CROOK-4)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build-crook4",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/mera400-toolchain.cmake",
        "-DMERA400_PLATFORM=crook",
        "-DMERA400_CROOK_VERSION=4",
        "-DLLVM_BIN_DIR=${input:llvmBinDir}"
      ],
      "problemMatcher": []
    },
    {
      "label": "build (CROOK-4)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build-crook4"],
      "problemMatcher": []
    },
    {
      "label": "test (CROOK-4)",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build-crook4", "--output-on-failure"],
      "dependsOn": "build (CROOK-4)",
      "problemMatcher": []
    },
    {
      "label": "image2assm (CROOK image to ASSM text)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/image2assm.py",
        "${input:crookImage}",
        "--title", "${input:crookTitle}",
        "-o", "${input:crookImage}.asm"
      ],
      "problemMatcher": []
    },
    {
      "label": "configure (large model)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build-large",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/mera400-toolchain.cmake",
        "-DMERA400_MODEL=large",
        "-DLLVM_BIN_DIR=${input:llvmBinDir}"
      ],
      "problemMatcher": []
    },
    {
      "label": "build (large model)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build-large"],
      "problemMatcher": []
    },
    {
      "label": "test (large model)",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build-large", "--output-on-failure"],
      "dependsOn": "build (large model)",
      "problemMatcher": []
    }
  ]
}
